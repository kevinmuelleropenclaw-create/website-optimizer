# Backend
PORT=8080
PUBLIC_BASE_URL=http://localhost:8080
NODE_ENV=development

# CORS (production: set to your frontend domain)
CORS_ORIGIN=*

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
API_RATE_LIMIT_WINDOW_MS=3600000
API_RATE_LIMIT_MAX=10

# Request Timeouts (milliseconds)
REQUEST_TIMEOUT_MS=30000
SSE_MAX_DURATION_MS=600000

# Scraping
SCRAPE_TIMEOUT_MS=30000
SCRAPE_MAX_REDIRECTS=5
SCRAPE_MAX_SIZE_MB=10

# Worker
WORKER_TIMEOUT_MS=300000
MAX_CONCURRENT_JOBS=1

# Optional: OpenAI for AI analysis
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=60000

# Netlify
NETLIFY_TOKEN=
# Optional: if you want to deploy into an existing site
NETLIFY_SITE_ID=
# Optional: custom site name (must be unique). If empty, Netlify generates a random name.
NETLIFY_SITE_NAME=
