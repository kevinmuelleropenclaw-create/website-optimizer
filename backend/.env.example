# Backend
PORT=8080
PUBLIC_BASE_URL=http://localhost:8080

# Optional: OpenAI for AI analysis
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Netlify
NETLIFY_TOKEN=
# Optional: if you want to deploy into an existing site
NETLIFY_SITE_ID=
# Optional: custom site name (must be unique). If empty, Netlify generates a random name.
NETLIFY_SITE_NAME=
