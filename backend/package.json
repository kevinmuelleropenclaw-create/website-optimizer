{
  "name": "website-optimizer-backend",
  "version": "1.0.1",
  "description": "Website Optimizer - Scrape, Analyze, Optimize, and Deploy to Netlify",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "start:prod": "NODE_ENV=production node src/server.js",
    "security:audit": "npm audit --audit-level=moderate",
    "docker:build": "docker build -t website-optimizer:latest .",
    "docker:run": "docker run -p 8080:8080 --env-file backend/.env website-optimizer:latest",
    "health:check": "curl -f http://localhost:8080/api/health || exit 1"
  },
  "keywords": [
    "website-optimizer",
    "seo",
    "performance",
    "netlify",
    "ai-analysis"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "archiver": "^7.0.1",
    "better-sqlite3": "^11.8.1",
    "cheerio": "^1.0.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.2.1",
    "express-timeout-handler": "^2.2.2",
    "helmet": "^8.1.0",
    "zod": "^3.23.8"
  }
}
